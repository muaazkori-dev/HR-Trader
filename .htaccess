# HR Traders Apache Configuration

# Safety block for mod_php configurations to avoid 500 errors
<IfModule mod_php7.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value memory_limit 128M
</IfModule>
<IfModule mod_php.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value memory_limit 128M
</IfModule>

# Enable URL rewrite rules if needed in future
Options -Indexes
